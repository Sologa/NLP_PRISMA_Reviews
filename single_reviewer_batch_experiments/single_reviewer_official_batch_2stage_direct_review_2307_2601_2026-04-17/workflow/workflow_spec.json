{
  "workflow_id": "single-reviewer-official-batch-2stage-direct-review",
  "aliases": [
    "single-reviewer-2stage-direct-review",
    "official-batch-2stage-direct-review"
  ],
  "workflow_arm": "single-reviewer-official-batch-2stage-direct-review",
  "stage_model": "two_stage_direct_review",
  "supported_phases": [
    {
      "phase_id": "stage1_review",
      "stage": "stage1",
      "template": "templates/01_stage1_direct_review_TEMPLATE.md",
      "output_filename": "stage1_review.json",
      "uses_fulltext": false,
      "requires_prior_stage": false
    },
    {
      "phase_id": "stage2_review",
      "stage": "stage2",
      "template": "templates/02_stage2_direct_review_TEMPLATE.md",
      "output_filename": "stage2_review.json",
      "uses_fulltext": true,
      "requires_prior_stage": true
    }
  ],
  "gate_policy": {
    "selection_phase": "stage1_review",
    "advance_decisions": [
      "include",
      "maybe"
    ],
    "stop_decisions": [
      "exclude"
    ]
  },
  "result_mapping": {
    "cutoff_verdict": "exclude (cutoff_time_window)",
    "stage_verdict_format": "{decision} ({stage}:{score})"
  }
}
