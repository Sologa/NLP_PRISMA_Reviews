# ==== Core files to exclude for GitHub upload ====
*.pdf
*.zip
*.log
*.pyc

# Bytecode/cache
__pycache__/
*.DS_Store
.DS_Store
.vscode/

# Secrets / environment
.env

# Keep refs mostly as metadata only (json/jsonl)
refs/
!refs/*/
!refs/*/metadata/
!refs/*/metadata/*.jsonl
!refs/*/metadata/*.json

# Exclude markdown outputs and generated content under refs
refs/*/mds/
refs/*/tex_src/

# Exclude LaTeX / style sources and build artifacts
*.tex
*.sty
*.cls
*.bst
*.bbx
*.cbx
*.ins
*.dtx
*.bbl

# Exclude legacy/legacy-style scratch data
refs_old/

# Exclude generated/vendor temp outputs
results/
!screening/results/
!screening/results/**/*.json
!screening/results/**/*.jsonl
screening/results/**/batch_jobs/**/input.jsonl
screening/results/**/batch_jobs/**/output.jsonl
screening/results/**/batch_jobs/**/error.jsonl
screening/results/**/batch_jobs/**/upload_file.json
screening/results/**/batch_jobs/**/batch_create.json
screening/results/**/batch_jobs/**/parsed_results.json
screening/results/**/papers/**/fulltext_resolution_audit.json
arxiv_tex_source_attempt/

# BCPCS spinoff generated run internals.
# Keep durable docs, src, reports, run manifests, aggregate summaries, and
# assembled_results.json visible for review; ignore execution payloads and
# duplicate/per-paper raw run artifacts.
research_bcpcs_2026-04-18/runs/**/batch_jobs/
research_bcpcs_2026-04-18/runs/**/cost/
research_bcpcs_2026-04-18/runs/**/logs/
research_bcpcs_2026-04-18/runs/**/direct_calls/
research_bcpcs_2026-04-18/runs/**/papers/**/*.json
research_bcpcs_2026-04-18/runs/**/papers/**/*.jsonl
research_bcpcs_2026-04-18/runs/**/papers/**/*.txt
research_bcpcs_2026-04-18/runs/**/evaluation_inventory_private.json
research_bcpcs_2026-04-18/runs/**/full_corpus_inventory.json
research_bcpcs_2026-04-18/runs/**/failure_slice_keys.json
research_bcpcs_2026-04-18/runs/**/terminal_failure.json

# Local tool/project metadata
.specstory/

# temp downloads and outputs
2601_query_reconstruction/

# Local graphify outputs
graphify-out/
.graphify_*
